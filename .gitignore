# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source assets — not part of the deployed site, far too large to track
/Final Assets/
/Prior Models-20260817T221702Z-1-001/

# Source assets, not site assets.
# `3d models/` is 873MB of Blender project files — the ORIGINALS the
# turntable meshes are exported from. The web-ready glTF that the site
# actually loads is committed (public/models/houses); the .blend set is a
# working directory, and scripts/export-models.mjs is the reproducible path
# from one to the other.
/3d models/

# Downloaded bundles: the reference deploy the turntable was lifted from
# (34MB) and a design-system export. Neither is built from this repo.
/*.zip

# Pasted into lib/navigation.ts by hand; the script prints it, the catalogue owns it.
scripts/colourway-wiring.generated.txt

# The storefront scrape: 379MB of saved HTML, product JSON and full-size
# photography, some single files 19MB. Same bargain as `3d models/` above —
# these are the ORIGINALS, and what the site serves is derived from them by
# scripts/import-colourway-photography.mjs into public/images/<house>/variants
# at web weight, which IS committed. Re-fetch with scripts/scrape_arianoir.py
# and reshape with scripts/group_colorways.py.
/scrape/

# The supplied 234px macro crops, before they were placed under
# public/images/arca-i/thumbnails. Source, not site asset.
/color thumbnails/

# Scratch capture left at the repo root; nothing references it.
/scrub video.mp4

# The film masters. Same bargain as `3d models/` and `scrape/`: these are the
# ORIGINALS — one of them a 42MB, 20 Mbps, 1080p master with an audio track
# on a clip that only ever plays muted — and what the site serves is derived
# from them by scripts/compress-video.mjs into public/video at web weight,
# which IS committed.
/video source/

# The upright colourway masters, 1080x1920 PNGs at ~3MB each. Same bargain
# as `video source/` and `scrape/`: the originals stay out, and what the
# site serves is derived from them into
# public/images/arca-i/variants/tall at web weight, which IS committed.
/mobile color photos/
